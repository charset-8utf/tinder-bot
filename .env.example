# TinderBot — локальная конфигурация
# cp .env.example .env
#
# Подробности: README.md (Быстрый старт, Security, Telegram E2E)
#
# === Режим по умолчанию: Docker без Telegram (REST + Swagger) ===
#
# === Telegram E2E: раскомментируйте блок ниже и подставьте реальные токены ===
# TELEGRAM_BOT_REGISTER=true
# TELEGRAM_BOT_NAME=имя_бота_без_собаки
# TELEGRAM_BOT_TOKEN=123456789:AAH...   # из @BotFather, обязательно символ ':'
# OPENAI_TOKEN=sk-...                   # OpenAI sk-... или совместимый Bearer
# OPENAI_API_HOST=https://api.openai.com/
# OPENAI_MODEL=gpt-3.5-turbo
#
# Проверка:  mvn clean test
# Запуск:    docker compose up --build
# Swagger:   http://localhost:8080/swagger-ui.html
# OpenAPI:   http://localhost:8080/v3/api-docs
# Postgres:  localhost:5433 — БД/user/password = tinderbot (см. POSTGRES_*)
# Сброс БД:  docker compose down -v   # креды фиксируются при первом создании volume

# --- Telegram ---
TELEGRAM_BOT_REGISTER=false
TELEGRAM_BOT_NAME=test
TELEGRAM_BOT_TOKEN=test

# --- Postgres (docker-compose) ---
POSTGRES_DB=tinderbot
POSTGRES_USER=tinderbot
POSTGRES_PASSWORD=tinderbot
POSTGRES_PORT=5433
APP_PORT=8080

# --- OpenAI ---
OPENAI_TOKEN=test
OPENAI_API_HOST=https://api.openai.com/
OPENAI_MODEL=gpt-3.5-turbo

# --- REST API auth ---
API_SECURITY_ENABLED=true
JWT_SECRET=demo-only-jwt-secret-change-me-in-real-projects-32-plus-chars
JWT_EXPIRATION_MINUTES=60
